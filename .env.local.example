# Local secrets - NEVER committed to version control
# Copy this file to .env.local and fill in your actual credentials

# Alpha Vantage API Credentials
# Get this from https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_api_key_here
ALPHA_VANTAGE_VERIFY_SSL=true
ALPHA_VANTAGE_ALLOW_INSECURE_SSL_FALLBACK=true

# Optional: override allowed frontend origins for CORS
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# GitHub Personal Access Token (optional, for GitHub MCP integration)
# Create at https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=
