# Local secrets - NEVER committed to version control
# Copy this file to .env.local and fill in your actual credentials

# Interactive Brokers API Credentials
# Get these from https://www.interactivebrokers.com/en/trading/ibkr-apis.php
IBKR_API_KEY=your_api_key_here
IBKR_API_SECRET=your_api_secret_here
IBKR_ACCOUNT_ID=your_account_id_here

# GitHub Personal Access Token (optional, for GitHub MCP integration)
# Create at https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=
